# Copy this file to .env and fill in the values locally.
# Do not commit .env or paste API keys or session codes into chat.
#
# Provide one credential:
# - JINKO_API_KEY (preferred): long-lived key, suitable for this file. It serves
#   every SDK process, so agents do not need a new code per command.
# - JINKO_SESSION_CODE: single-use code from the Jinko MCP tool get_session_code,
#   only when no API key is available. Export a fresh code for each SDK process.
#   Do not store it here.
# When both are set, JINKO_SESSION_CODE is the credential used, so leave it unset.

# A project API key, or an organization API key that reaches several projects.
JINKO_API_KEY=""
# The project to work in. Optional with an organization key: leave it empty to
# work across projects. When it is empty, the agent lists the projects the key
# can see and asks which one to use.
JINKO_PROJECT_ID=""
JINKO_BASE_URL="https://api.jinko.ai"
JINKO_URL="https://jinko.ai"