# Copy this file to .env and fill in the values locally.
# Do not commit .env or paste API keys or session codes into chat.
#
# Provide JINKO_PROJECT_ID and one credential:
# - JINKO_API_KEY: long-lived key, suitable for this file.
# - JINKO_SESSION_CODE: single-use code from the Jinko MCP tool get_session_code.
#   Export a fresh code for each SDK process. Do not store it here.
# When both are set, JINKO_SESSION_CODE is the credential used.

# A project API key, or an organization API key that reaches several projects.
JINKO_API_KEY=""
# The project to work in. Optional with an organization key: leave it empty to
# work across projects, or pick one listed by JinkoOrgClient().list_projects().
JINKO_PROJECT_ID=""
JINKO_BASE_URL="https://api.jinko.ai"
JINKO_URL="https://jinko.ai"