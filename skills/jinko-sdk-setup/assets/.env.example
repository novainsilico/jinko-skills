# Copy this file to .env and fill in the values locally.
# Do not commit .env or paste API keys into chat.

# A project API key, or an organization API key that reaches several projects.
JINKO_API_KEY=""
# The project to work in. Optional with an organization key: leave it empty to
# work across projects, or pick one listed by JinkoOrgClient().list_projects().
JINKO_PROJECT_ID=""
JINKO_BASE_URL="https://api.jinko.ai"
JINKO_URL="https://jinko.ai"